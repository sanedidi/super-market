# Скопируй в .env и поменяй значения для сервера.
# Для локальной разработки .env не обязателен — есть значения по умолчанию.

APP_ENV=dev
LOG_LEVEL=info

POSTGRES_USER=market
POSTGRES_PASSWORD=market
POSTGRES_DB=market
DB_PORT=5432

REDIS_PORT=6379

MINIO_ROOT_USER=market
MINIO_ROOT_PASSWORD=market-secret

API_PORT=8080

# Авторизация. В prod JWT_SECRET обязателен (32+ символов): openssl rand -hex 32
JWT_SECRET=
# Номера супер-админов через запятую: +998901234567,+998907654321
SUPER_ADMIN_PHONES=
# Только для dev: фиксированный код входа, Telegram не нужен. В prod запрещён.
DEV_OTP_CODE=

# Telegram-бот для кодов входа (@BotFather). Имя бота определяется само.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Онлайн-оплата. Пустые ключи — способ оплаты выключен.
# Payme: адрес для кабинета — https://<домен>/api/v1/payments/payme
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_TEST=false
# Click: Prepare — /api/v1/payments/click/prepare, Complete — /api/v1/payments/click/complete
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
# Куда вернуть покупателя после оплаты (диплинк приложения).
PAYMENT_RETURN_URL=
# Неоплаченный заказ истекает; непринятый оплаченный — уведомление супер-админу.
PAYMENT_TIMEOUT=15m
ACCEPT_TIMEOUT=10m

# Push-уведомления покупателям (Firebase Cloud Messaging): ключ сервисного
# аккаунта Firebase — JSON одной строкой в base64 (base64 -i key.json) или путь
# к файлу. Пусто — уведомления о заказах уходят в Telegram-бот.
FCM_CREDENTIALS=
# Ссылки в профиле приложения. SUPPORT_URL по умолчанию — t.me/<бот>.
SUPPORT_URL=
PRIVACY_URL=
# Условия для курьеров «по пути» (ссылка на экране входа приложения курьера).
COURIER_TERMS_URL=
# SMS-коды курьерам «по пути» через Eskiz (notify.eskiz.uz). Текст должен совпадать с одобренным шаблоном:
# "Super Market: kod dlya vhoda 123456. Nikomu ne soobshayte ego."
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546
